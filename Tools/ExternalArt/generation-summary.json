    "worldSize": [
      5,
      7.07258
    ],
    "texts": [
      "２年　算数　たしかめテスト",
      "２年１組　　氏名　森川 ひなた",
      "10",
      "0",
      "点",
      "よくがんばりました！",
      "１　つぎの計算をしましょう。",
      "12 + 8 = 20",
      "30 - 7 = 23",
      "２　かけ算の答えを書きましょう。",
      "6 × 4 = 24",
      "8 × 7 = 56",
      "３　式と答えを書きましょう。",
      "えんぴつが５本ずつ、３つあります。",
      "5 × 3 = 15　　答え 15本",
      "４　長さを求めましょう。",
      "25 cm + 35 cm = 60 cm",
      "答え　60 cm",
      "計算の途中も、ていねいに書けています。"
    ],
    "layers": [
